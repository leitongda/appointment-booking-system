{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".umi/**", ".umi-production/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["PROXY_TARGET", "HOST", "PORT"]
    },
    "dev:prod": {
      "cache": false,
      "persistent": true,
      "env": ["PROXY_TARGET", "HOST", "PORT"]
    },
    "dev:local": {
      "cache": false,
      "persistent": true,
      "env": ["PROXY_TARGET", "HOST", "PORT"]
    },
    "dev:remote": {
      "cache": false,
      "persistent": true,
      "env": ["PROXY_TARGET", "HOST", "PORT"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false
    }
  }
}

