# ============================================
# Docker Compose 部署环境变量配置
# ============================================
# 复制此文件为 .env 并填写实际配置值
# cp .env.example .env

# ============ 数据库配置（必填）============
# PostgreSQL 异步连接 URL
# 格式: postgresql+asyncpg://用户名:密码@主机:5432/数据库名
DATABASE_URL=postgresql+asyncpg://hospital:your-password@host.docker.internal:5432/hospital_booking

# ============ Redis 配置（必填）============
# Redis 连接 URL
# 格式: redis://主机:6379/数据库编号
REDIS_URL=redis://host.docker.internal:6379/0

# ============ JWT 密钥（必填）============
# 生成方法: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# ============ 微信小程序配置（可选）============
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ============ Flower 监控配置（必填）============
# 基本认证，格式: 用户名:密码
FLOWER_BASIC_AUTH=admin:change-this-password

# ============ Grafana 配置（可选，监控栈使用）============
# 默认 admin/admin，生产环境请通过此变量覆盖
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-this-password
