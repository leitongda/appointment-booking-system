{
  "name": "appointment-booking-system",
  "version": "1.0.0",
  "private": true,
  "description": "医院挂号系统 - 机构端 + 患者端 + 医生端 + 临时挂号H5 + 预约小程序",
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@hospital/admin",
    "dev:admin:local": "turbo run dev:local --filter=@hospital/admin",
    "dev:admin:remote": "turbo run dev:remote --filter=@hospital/admin",
    "dev:patient-h5": "turbo run dev --filter=@hospital/patient-h5",
    "dev:patient-miniapp": "turbo run dev --filter=@hospital/patient-miniapp",
    "dev:patient-miniapp:local": "turbo run dev:local --filter=@hospital/patient-miniapp",
    "dev:patient-miniapp:remote": "turbo run dev:remote --filter=@hospital/patient-miniapp",
    "dev:patient-miniapp:prod": "turbo run dev:prod --filter=@hospital/patient-miniapp",
    "dev:miniapp-instance": "turbo run dev --filter=@hospital/miniapp-instance",
    "dev:miniapp-instance:local": "turbo run dev:local --filter=@hospital/miniapp-instance",
    "build:miniapp-instance": "turbo run build:weapp --filter=@hospital/miniapp-instance",
    "build:miniapp-instance:template": "cd apps/miniapp-instance && pnpm build:template",
    "build:miniapp-instance:all": "cd apps/miniapp-instance && pnpm build:all",
    "dev:mini-appointment": "cd apps/mini-appointment-miniapp && pnpm run dev:weapp",
    "dev:mini-appointment:h5": "cd apps/mini-appointment-miniapp && pnpm run dev:h5",
    "dev:mini-appointment:alipay": "cd apps/mini-appointment-miniapp && pnpm run dev:alipay",
    "build:mini-appointment": "cd apps/mini-appointment-miniapp && pnpm run build:weapp",
    "dev:doctor": "turbo run dev --filter=@hospital/doctor",
    "dev:temp-registration": "turbo run dev --filter=@hospital/temp-registration",
    "dev:website": "turbo run dev --filter=@hospital/website",
    "dev:server": "cd apps/server && PYTHON_BIN=${SERVER_PYTHON:-python3} && if [ -x .venv/bin/python ]; then PYTHON_BIN=.venv/bin/python; fi && $PYTHON_BIN -m uvicorn app.main:app --reload --host 0.0.0.0 --port ${SERVER_PORT:-9000}",
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=@hospital/admin",
    "build:patient-h5": "turbo run build --filter=@hospital/patient-h5",
    "build:patient-miniapp": "turbo run build --filter=@hospital/patient-miniapp",
    "build:doctor": "turbo run build --filter=@hospital/doctor",
    "build:temp-registration": "turbo run build --filter=@hospital/temp-registration",
    "build:website": "turbo run build --filter=@hospital/website",
    "deploy:frontend": "node scripts/deploy-frontend.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "e2e:admin": "playwright test",
    "test:e2e:patient-h5": "playwright test --config=playwright.patient-h5.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:patient-miniapp-cache": "pnpm --filter @hospital/patient-miniapp clean:cache",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "figlet": "^1.8.0",
    "ora": "^9.4.1",
    "prompts": "^2.4.2",
    "turbo": "^2.10.0"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
