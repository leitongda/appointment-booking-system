{
  "name": "appointment-booking-system",
  "version": "1.0.0",
  "private": true,
  "description": "医院挂号系统 - 机构端 + 患者端 + 医生端 + 临时挂号H5",
  "scripts": {
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@hospital/admin",
    "dev:admin:local": "turbo run dev:local --filter=@hospital/admin",
    "dev:admin:remote": "turbo run dev:remote --filter=@hospital/admin",
    "dev:patient-h5": "turbo run dev --filter=@hospital/patient-h5",
    "dev:patient-miniapp": "turbo run dev --filter=@hospital/patient-miniapp",
    "dev:patient-miniapp:local": "turbo run dev:local --filter=@hospital/patient-miniapp",
    "dev:patient-miniapp:remote": "turbo run dev:remote --filter=@hospital/patient-miniapp",
    "dev:patient-miniapp:prod": "turbo run dev:prod --filter=@hospital/patient-miniapp",
    "dev:doctor": "turbo run dev --filter=@hospital/doctor",
    "dev:temp-registration": "turbo run dev --filter=@hospital/temp-registration",
    "dev:server": "cd apps/server && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=@hospital/admin",
    "build:patient-h5": "turbo run build --filter=@hospital/patient-h5",
    "build:patient-miniapp": "turbo run build --filter=@hospital/patient-miniapp",
    "build:doctor": "turbo run build --filter=@hospital/doctor",
    "build:temp-registration": "turbo run build --filter=@hospital/temp-registration",
    "deploy:frontend": "node scripts/deploy-frontend.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:patient-miniapp-cache": "pnpm --filter @hospital/patient-miniapp clean:cache"
  },
  "devDependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "figlet": "^1.8.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2",
    "turbo": "^2.7.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
