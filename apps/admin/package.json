    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hospital/api": "workspace:*",
    "@hospital/shared": "workspace:*",
    "@umijs/max": "^4.6.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "antd": "^5.29.3",
    "dayjs": "^1.11.10",
    "lodash-es": "^4.17.21",
    "pinyin-pro": "^3.27.0",
    "react-image-crop": "^11.0.7"
