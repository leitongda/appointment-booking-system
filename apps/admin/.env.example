# 高德地图 API Key
# 请到 https://lbs.amap.com/api/javascript-api-v2/prerequisites 申请
AMAP_KEY=your_amap_key_here

# TinyMCE API Key
# 富文本编辑器 API 密钥
# 请到 https://www.tiny.cloud 申请
TINYMCE_API_KEY=your_tinymce_api_key_here

# API 基础路径 (一般不需要修改)
API_BASE_URL=/api/v1

# ====================================
# 开发环境配置说明
# ====================================
# 本项目支持两种开发环境：
# 1. 本地开发环境 - 连接本地后端服务器
# 2. 远程开发环境 - 连接线上后端服务器
#
# 使用方式：
# - 本地开发：pnpm dev:local （自动使用 localhost:8000）
# - 远程开发：pnpm dev:remote （自动使用 https://yy.aicm.online）
#
# 如果需要自定义后端地址，可以创建 .env.local 文件：
# PROXY_TARGET=http://your-backend-url
