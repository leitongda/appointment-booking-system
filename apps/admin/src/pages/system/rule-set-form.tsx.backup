                        />

                        <ProFormSwitch
                          name="enabled"
                          label="启用状态"
                          extra="禁用后规则不会生效"
                        />

                        <ProFormTextArea
                          name="description"
                          label="描述"
                          width="lg"
                          fieldProps={{ rows: 3 }}
                          placeholder="请输入规则组描述"
                        />
                      </Card>
