[importlinter]
root_package = app

# Contract 1: Layered architecture
# Dependency direction: api -> modules -> common -> infrastructure -> core -> db
# NOTE: app.api.deps is a shared dependency injection module that modules legitimately import.
# This is a design decision, not a layer violation.
[importlinter:layered-architecture]
name = layered-architecture
type = layers
layers =
    app.api
    app.modules
    app.common
    app.infrastructure
    app.core
    app.db
ignore_imports =
    # modules -> api.deps: shared dependency injection (by design)
    app.modules.** -> app.api.deps
    # infrastructure -> common: notification preferences, quotas, secrets (by design)
    app.infrastructure.** -> app.common.**
    # infrastructure -> modules: known violations that need refactoring (tracked in issue #XXX)
    app.infrastructure.email.service -> app.modules.email_templates.service
    app.infrastructure.email.service -> app.modules.settings.service
    app.infrastructure.image.processor -> app.modules.settings.service
    app.infrastructure.notifications.channels.wechat -> app.modules.unified_message.models
    app.infrastructure.notifications.quota -> app.modules.notification_logs.service
    # common -> modules: known violations that need refactoring (tracked in issue #XXX)
    app.common.feature_flags -> app.modules.tenants.schemas
    app.common.security_settings -> app.modules.settings.service
    # db -> core: session needs config for connection (by design)
    app.db.** -> app.core.config

# Contract 2: Infrastructure must not depend on modules (except noted exceptions)
[importlinter:infrastructure-no-modules-dep]
name = infrastructure-no-modules-dep
type = forbidden
source_modules = app.infrastructure
forbidden_modules = app.modules
ignore_imports =
    # These are known violations that need refactoring:
    # - email service needs email_templates and settings
    # - image processor needs settings
    # - wechat channel needs unified_message models
    # - notifications quota needs notification_logs
    app.infrastructure.email.service -> app.modules.email_templates.service
    app.infrastructure.email.service -> app.modules.settings.service
    app.infrastructure.image.processor -> app.modules.settings.service
    app.infrastructure.notifications.channels.wechat -> app.modules.unified_message.models
    app.infrastructure.notifications.quota -> app.modules.notification_logs.service

# Contract 3: Core must not depend on upper layers
[importlinter:core-no-modules-dep]
name = core-no-modules-dep
type = forbidden
source_modules = app.core
forbidden_modules = app.modules

[importlinter:core-no-infra-dep]
name = core-no-infra-dep
type = forbidden
source_modules = app.core
forbidden_modules = app.infrastructure

[importlinter:core-no-common-dep]
name = core-no-common-dep
type = forbidden
source_modules = app.core
forbidden_modules = app.common

# Contract 4: DB must not depend on modules
[importlinter:db-no-modules-dep]
name = db-no-modules-dep
type = forbidden
source_modules = app.db
forbidden_modules = app.modules

# Contract 5: Middleware must not depend on modules
[importlinter:middleware-no-modules-dep]
name = middleware-no-modules-dep
type = forbidden
source_modules = app.middleware
forbidden_modules = app.modules
