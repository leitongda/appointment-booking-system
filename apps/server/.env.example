# ============================================
# 医院挂号系统 - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并修改相应的值
# cp .env.example .env

# ============================================
# 基础配置
# ============================================
PROJECT_NAME=医院挂号系统
API_PREFIX=/api
API_VERSION=v1

# 环境配置: development, staging, production
ENVIRONMENT=development
DEBUG=true

# ============================================
# 数据库配置 (PostgreSQL)
# ============================================
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://hospital:hospital123@localhost:5432/hospital_booking

# 连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ============================================
# Redis 配置
# ============================================
# 格式: redis://主机:端口/数据库编号
REDIS_URL=redis://localhost:6379/0

# ============================================
# JWT 认证配置
# ============================================
# 重要：生产环境必须修改为强随机字符串！
# 可使用: openssl rand -hex 32 生成
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# RSA 密钥配置 (用于密码加密传输)
# ============================================
# 可选，开发环境会自动生成
# 生产环境建议配置固定密钥
# RSA_PRIVATE_KEY=
# RSA_PUBLIC_KEY=

# ============================================
# CORS 跨域配置
# ============================================
# JSON 格式的域名列表
BACKEND_CORS_ORIGINS=["http://localhost:8002", "http://localhost:8003", "http://localhost:8005", "http://127.0.0.1:8002", "http://127.0.0.1:8003", "http://127.0.0.1:8005"]

# ============================================
# 限流配置
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_SECOND=10

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON_FORMAT=false

# ============================================
# 微信小程序配置 (可选)
# ============================================
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# ============================================
# 短信服务配置
# ============================================
# 短信服务商: mock, aliyun, tencent
SMS_PROVIDER=mock

# 阿里云短信配置
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# ============================================
# 存储配置
# ============================================
# 存储类型: local, minio, cos
STORAGE_TYPE=local

# 本地存储配置
LOCAL_UPLOAD_DIR=uploads
# LOCAL_PUBLIC_URL=

# MinIO 对象存储配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hospital
MINIO_SECURE=false
# MINIO_PUBLIC_URL=

# 腾讯云 COS 配置 (可选)
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-guangzhou
# COS_BUCKET=
# COS_CDN_DOMAIN=

# ============================================
# 预约系统配置
# ============================================
# 提前多少小时发送预约提醒
APPOINTMENT_REMINDER_HOURS=24

# 自动生成未来多少天的排班
SCHEDULE_AUTO_GENERATE_DAYS=14

# ============================================
# 第三方服务配置 (可选)
# ============================================
# TinyMCE 富文本编辑器 API Key
# TINYMCE_API_KEY=
