# ============================================
# 医院挂号系统 - 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填写实际配置值
# cp .env.example .env

# ============ 基础配置 ============
ENVIRONMENT=development
DEBUG=true

# ============ 数据库配置 ============
# PostgreSQL 异步连接 URL（FastAPI 使用）
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hospital

# ============ Redis 配置 ============
REDIS_URL=redis://localhost:6379/0

# ============ JWT 配置 ============
# 生成方法: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# ============ 微信小程序配置 ============
# 在微信公众平台 -> 开发管理 -> 开发设置 中获取
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
# 微信回调 Token（用于验证回调签名，与微信公众平台后台配置一致）
# 在微信公众平台 -> 开发管理 -> 接收消息 -> 事件推送 中配置
WECHAT_CALLBACK_TOKEN=your-wechat-callback-token

# ============ 第三方集成配置（钉钉/企业微信/飞书） ============
# 注：以下为全局默认值；多租户下每个租户可在「系统配置-第三方集成」页覆盖。
# 敏感 Secret 仅放环境变量，数据库以 env: 引用（如 env:DINGTALK_APP_SECRET）。
# 钉钉企业内部应用（https://open-dev.dingtalk.com）
# DINGTALK_APP_KEY=your-dingtalk-app-key
# DINGTALK_APP_SECRET=your-dingtalk-app-secret
# DINGTALK_AGENT_ID=your-dingtalk-agent-id
# 企业微信自建应用（https://work.weixin.qq.com）
# WECOM_CORP_ID=your-wecom-corp-id
# WECOM_APP_SECRET=your-wecom-app-secret
# WECOM_AGENT_ID=your-wecom-agent-id
# 飞书自建应用（https://open.feishu.cn）
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# ============ 限流配置 ============
# 生产环境默认启用，建议保持开启以防止 API 滥用
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_SECOND=10

# ============ 分页配置 ============
# 默认每页数量
DEFAULT_PAGE_SIZE=10
# 通用最大每页数量
MAX_PAGE_SIZE=500
# 预约列表专用最大每页数量（需管理员权限+日期范围才能超过100）
# APPOINTMENTS_MAX_PAGE_SIZE=500

# ============ 日志配置 ============
RUNTIME_DATA_DIR=var/server
LOG_LEVEL=INFO
LOG_DIR=var/server/logs
LOG_JSON_FORMAT=false
# 生产环境建议设为 true，启用结构化 JSON 日志（包含 trace_id, tenant_id, user_id 等字段）

# ============ 短信配置（可选）============
SMS_PROVIDER=mock
# ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
# SMS_SIGN_NAME=your-sms-sign-name
# SMS_TEMPLATE_CODE=your-sms-template-code

# ============ 存储配置 ============
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=var/server/uploads

# MinIO 配置（如果使用 MinIO）
# STORAGE_TYPE=minio
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=your-minio-access-key
# MINIO_SECRET_KEY=your-minio-secret-key
# MINIO_BUCKET=hospital
# MINIO_SECURE=false

# ============ 知识库（RAG，openspec add-knowledge-base-rag）============
# 灰度开关：false 时 /knowledge 路由整体 404，前端页面提示「功能未启用」；先 false 上线，再打开
KB_ENABLED=false
# embedding 走 OpenAI 兼容 /embeddings 接口（生产机 3.6G 内存无法自托管模型）。预设三选一，默认模型均 1024 维：
#   siliconflow → 硅基流动 BAAI/bge-m3（免费，推荐）   zhipu → 智谱 embedding-3（¥0.5/百万 token）   dashscope → 阿里百炼 text-embedding-v3
#   openai_compatible → 自定义网关，需同时填 KB_EMBEDDING_BASE_URL / KB_EMBEDDING_MODEL
# 模型/维度切换 = 整库重建，禁止同库混维
KB_EMBEDDING_PROVIDER=siliconflow
# KB_EMBEDDING_API_KEY=your-provider-api-key
# KB_EMBEDDING_BASE_URL=            # 留空用预设地址
# KB_EMBEDDING_MODEL=               # 留空用预设模型
KB_EMBEDDING_DIMS=1024
# KB_EMBEDDING_SEND_DIMENSIONS=     # true/false 显式控制请求是否带 dimensions 参数；留空按预设（bge 系列不支持）
# ZHIPU_API_KEY=                    # 仅 zhipu 预设的兼容写法，等价于 KB_EMBEDDING_API_KEY
# 单文件上限（MB）；nginx client_max_body_size 需同步放宽（建议 60m）
KB_MAX_FILE_MB=50
# 解析临时目录：必须是磁盘路径；容器内 /tmp 是 tmpfs（占内存），compose 已挂 ./apps/server/var/kb-tmp
KB_TMP_DIR=var/server/kb-tmp
# 数据库前置：pgvector 扩展需由超级用户 CREATE EXTENSION vector（迁移 kb01 会检查并给出指引）

# ============ RSA 密钥（可选，用于密码加密传输）============
# 生产环境请配置实际的密钥，开发环境会自动生成
# RSA_PRIVATE_KEY=your-rsa-private-key
# RSA_PUBLIC_KEY=your-rsa-public-key

# ============ SMTP 密码加密密钥（必需）============
# 用于加密存储在数据库中的 SMTP 密码
# 未设置时每次重启会生成新密钥，导致已加密密码不可解密
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_ENCRYPTION_KEY=your-fernet-key-change-this-in-production

# ============ TinyMCE 配置（可选）============
# TINYMCE_API_KEY=your-tinymce-api-key

# ============ 规则引擎性能监控配置（可选）============
# 是否启用规则引擎性能监控
RULE_PERFORMANCE_MONITORING_ENABLED=true
# 慢查询阈值（毫秒），超过此值的查询将被记录为慢查询
RULE_SLOW_QUERY_THRESHOLD=100
# 性能指标保留时间（秒），默认 7 天（604800 秒）
RULE_METRICS_TTL=604800
# 慢查询日志保留时间（秒），默认 30 天（2592000 秒）
RULE_SLOW_QUERY_TTL=2592000

# ============ 高德地图配置（可选）============
# 高德地图 Web 服务 API Key（用于地理编码、逆地理编码、POI 搜索）
# 在 https://console.amap.com/dev/key/app 创建应用获取
AMAP_KEY=your-amap-key-here

# ============ Sentry APM 配置（可选）============
# Sentry DSN，为空则不启用 Sentry APM
SENTRY_DSN=
# 性能追踪采样率 (0.0 ~ 1.0)，生产环境建议 0.1 (10%)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============ Celery Flower 监控配置 ============
# Flower 监控端口（默认 5555）
FLOWER_PORT=5555
# Flower 基本认证（用户名:密码）
# 生产环境请修改默认密码
FLOWER_BASIC_AUTH=admin:admin123

# ============ 多租户灰度开关（R4-7）============
# 全部默认值必须与 app/core/config.py:131-148 保持一致。
# 翻转顺序与观测指标见 docs/tenant-remaining-plan.md 第 5 节；
# 原则：一次只翻一个、观察至少一个业务日、异常立即改回默认值并重启。
# 未完成第 5.1 节门禁前，不要改动以下任何一项。

# 遗留 User 表管理员兼容（True=保留旧行为；观测 keyword 命中=0 跨 2 周期后才可翻 False）
LEGACY_USER_ADMIN_FALLBACK=true
# 非平台管理员缺少 tenant_id 时拒绝（fail-close）而非放行全量
TENANT_FILTER_FAIL_CLOSE=false
# 把 X-Tenant-Code/子域名解析回填为 tenant_id（独立回滚）
TENANT_CODE_TO_ID_RESOLVE=false
# 请求租户编码与账号租户不一致时拒绝（fail-close）
TENANT_CONSISTENCY_FAIL_CLOSE=false
# 患者/医生端缺少租户上下文时拒绝（fail-close）
PATIENT_ANCHOR_FAIL_CLOSE=false
# 公开端额外强制租户上下文的路径前缀（JSON 数组，灰度默认空）
PUBLIC_TENANT_REQUIRED_EXTRA_PATHS=[]

# 租户物理删除开关（本期仅 dry-run，不接线；禁止在发布环境打开 ENABLED）
TENANT_PURGE_ENABLED=false
TENANT_PURGE_DRY_RUN=true

# 功能开关强制消费（P4-8 试点：online_payment；默认关闭）
FEATURE_ENFORCEMENT_ENABLED=false
