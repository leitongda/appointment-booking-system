# ============================================
# 医院挂号系统 - 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填写实际配置值
# cp .env.example .env

# ============ 基础配置 ============
ENVIRONMENT=development
DEBUG=true

# ============ 数据库配置 ============
# PostgreSQL 异步连接 URL（FastAPI 使用）
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hospital

# ============ Redis 配置 ============
REDIS_URL=redis://localhost:6379/0

# ============ JWT 配置 ============
# 生成方法: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# ============ 微信小程序配置 ============
# 在微信公众平台 -> 开发管理 -> 开发设置 中获取
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# ============ 限流配置 ============
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_SECOND=10

# ============ 分页配置 ============
# 默认每页数量
DEFAULT_PAGE_SIZE=10
# 通用最大每页数量
MAX_PAGE_SIZE=500
# 预约列表专用最大每页数量（需管理员权限+日期范围才能超过100）
# APPOINTMENTS_MAX_PAGE_SIZE=500

# ============ 日志配置 ============
RUNTIME_DATA_DIR=var/server
LOG_LEVEL=INFO
LOG_DIR=var/server/logs
LOG_JSON_FORMAT=false

# ============ 短信配置（可选）============
SMS_PROVIDER=mock
# ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
# SMS_SIGN_NAME=your-sms-sign-name
# SMS_TEMPLATE_CODE=your-sms-template-code

# ============ 存储配置 ============
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=var/server/uploads

# MinIO 配置（如果使用 MinIO）
# STORAGE_TYPE=minio
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=your-minio-access-key
# MINIO_SECRET_KEY=your-minio-secret-key
# MINIO_BUCKET=hospital
# MINIO_SECURE=false

# ============ RSA 密钥（可选，用于密码加密传输）============
# 生产环境请配置实际的密钥，开发环境会自动生成
# RSA_PRIVATE_KEY=your-rsa-private-key
# RSA_PUBLIC_KEY=your-rsa-public-key

# ============ TinyMCE 配置（可选）============
# TINYMCE_API_KEY=your-tinymce-api-key

# ============ 规则引擎性能监控配置（可选）============
# 是否启用规则引擎性能监控
RULE_PERFORMANCE_MONITORING_ENABLED=true
# 慢查询阈值（毫秒），超过此值的查询将被记录为慢查询
RULE_SLOW_QUERY_THRESHOLD=100
# 性能指标保留时间（秒），默认 7 天（604800 秒）
RULE_METRICS_TTL=604800
# 慢查询日志保留时间（秒），默认 30 天（2592000 秒）
RULE_SLOW_QUERY_TTL=2592000

# ============ 高德地图配置（可选）============
# 高德地图 Web 服务 API Key（用于地理编码、逆地理编码、POI 搜索）
# 在 https://console.amap.com/dev/key/app 创建应用获取
AMAP_KEY=your-amap-key-here

# ============ Celery Flower 监控配置 ============
# Flower 监控端口（默认 5555）
FLOWER_PORT=5555
# Flower 基本认证（用户名:密码）
# 生产环境请修改默认密码
FLOWER_BASIC_AUTH=admin:admin123
