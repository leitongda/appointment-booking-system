{
  "name": "@hospital/patient-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "医院挂号系统 - 患者端小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "less"
  },
  "scripts": {
    "build:weapp": "NO_PROXY='*' taro build --type weapp --no-check && node scripts/fix-wxml.js",
    "build:swan": "NO_PROXY='*' taro build --type swan",
    "build:alipay": "NO_PROXY='*' taro build --type alipay",
    "build:h5": "NO_PROXY='*' taro build --type h5",
    "dev:weapp": "NO_PROXY='*' node scripts/dev-weapp.mjs",
    "dev:weapp:prod": "NO_PROXY='*' NODE_ENV=production node scripts/dev-weapp.mjs --clean",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev": "npm run dev:weapp",
    "dev:prod": "npm run dev:weapp:prod",
    "dev:local": "NO_PROXY='*' TARO_APP_API_URL=http://127.0.0.1:9000/api/v1 node scripts/dev-weapp.mjs",
    "dev:remote": "NO_PROXY='*' TARO_APP_API_URL=https://yy.aicm.online/api/v1 node scripts/dev-weapp.mjs",
    "clean": "rm -rf dist",
    "clean:cache": "node scripts/clean.mjs",
    "fix:wxml": "node scripts/fix-wxml.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.8",
    "@hospital/api": "workspace:*",
    "@hospital/shared": "workspace:*",
    "@nutui/nutui-react-taro": "3.0.18",
    "@tarojs/components": "4.1.9",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-html": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.1.9",
    "@tarojs/react": "4.1.9",
    "@tarojs/runtime": "4.1.9",
    "@tarojs/shared": "4.1.9",
    "@tarojs/taro": "4.1.9",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tarojs/cli": "4.1.9",
    "@tarojs/taro-loader": "4.1.9",
    "@tarojs/webpack5-runner": "4.1.9",
    "@types/react": "^18.2.47",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "4.1.9",
    "less": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
