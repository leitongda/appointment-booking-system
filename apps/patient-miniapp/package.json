{
  "name": "@hospital/patient-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "医院挂号系统 - 患者端小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "less"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp && node scripts/fix-wxml.js",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:h5": "taro build --type h5",
    "dev:weapp": "taro build --type weapp --watch & node scripts/fix-wxml.js --watch",
    "dev:weapp:prod": "NODE_ENV=production taro build --type weapp --watch & node scripts/fix-wxml.js --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev": "npm run dev:weapp",
    "dev:prod": "npm run dev:weapp:prod",
    "dev:local": "TARO_APP_API_URL=http://127.0.0.1:8000/api/v1 taro build --type weapp --watch & node scripts/fix-wxml.js --watch",
    "dev:remote": "TARO_APP_API_URL=https://yy.aicm.online/api/v1 taro build --type weapp --watch & node scripts/fix-wxml.js --watch",
    "clean": "rm -rf dist",
    "clean:cache": "node scripts/clean.mjs",
    "fix:wxml": "node scripts/fix-wxml.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.8",
    "@hospital/api": "workspace:*",
    "@hospital/shared": "workspace:*",
    "@nutui/nutui-react-taro": "3.0.18",
    "@tarojs/components": "3.6.38",
    "@tarojs/helper": "3.6.38",
    "@tarojs/plugin-framework-react": "3.6.38",
    "@tarojs/plugin-html": "3.6.38",
    "@tarojs/plugin-platform-weapp": "3.6.38",
    "@tarojs/react": "3.6.38",
    "@tarojs/runtime": "3.6.38",
    "@tarojs/shared": "3.6.38",
    "@tarojs/taro": "3.6.38",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@tarojs/cli": "3.6.38",
    "@tarojs/taro-loader": "3.6.38",
    "@tarojs/webpack5-runner": "3.6.38",
    "@types/react": "^18.2.47",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "3.6.38",
    "less": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
