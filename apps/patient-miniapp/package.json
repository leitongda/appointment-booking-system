{
  "name": "@hospital/patient-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "医院挂号系统 - 患者端小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "less"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev": "npm run dev:weapp",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.8",
    "@hospital/api": "workspace:*",
    "@hospital/shared": "workspace:*",
    "@nutui/nutui-react-taro": "^2.3.0",
    "@tarojs/components": "3.6.22",
    "@tarojs/helper": "3.6.22",
    "@tarojs/plugin-framework-react": "3.6.22",
    "@tarojs/plugin-platform-weapp": "3.6.22",
    "@tarojs/react": "3.6.22",
    "@tarojs/runtime": "3.6.22",
    "@tarojs/shared": "3.6.22",
    "@tarojs/taro": "3.6.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@tarojs/cli": "3.6.22",
    "@tarojs/webpack5-runner": "3.6.22",
    "@types/react": "^18.2.47",
    "less": "^4.2.0",
    "typescript": "^5.3.3"
  }
}

