{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HospitalDoctor",
  "version": "../package.json",
  "identifier": "online.aicm.hospital.doctor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:9103",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "医院挂号系统 · 医生端",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEQ0VEMDI4ODM2ODJFODUKUldTRkxtaURLTkRPSFJlUE9EVU5ERjBycWpTeFN2YXNiZlJkMGk0S1dUeVVkazhQaFVFanJrdHcK",
      "endpoints": [
        "https://desktop-updates.invalid/desktop/updates/doctor/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
