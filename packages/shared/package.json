{
  "name": "@hospital/shared",
  "version": "1.0.0",
  "private": true,
  "description": "医院挂号系统 - 共享工具库",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./miniapp-auth": "./src/miniapp-auth.ts",
    "./miniapp": "./src/miniapp/index.ts",
    "./miniapp/*": "./src/miniapp/*.ts",
    "./miniapp/*.tsx": "./src/miniapp/*.tsx",
    "./miniapp/hooks": "./src/miniapp/hooks/index.ts",
    "./miniapp/hooks/*": "./src/miniapp/hooks/*.ts",
    "./miniapp/components": "./src/miniapp/components/index.ts",
    "./miniapp/components/*": "./src/miniapp/components/*.tsx",
    "./miniapp/stubs/*": "./src/miniapp/stubs/*.ts",
    "./components": "./src/components/index.ts",
    "./components/ImageUpload": "./src/components/ImageUpload/index.tsx",
    "./components/ImageUpload/types": "./src/components/ImageUpload/types.ts",
    "./components/ImageUpload/ImageCropper": "./src/components/ImageUpload/ImageCropper.tsx",
    "./components/*": "./src/components/*/index.tsx"
  },
  "scripts": {
    "lint": "echo 'lint not configured'",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "openapi-typescript src/types/api-generated/openapi.json -o src/types/api-generated/schema.d.ts"
  },
  "dependencies": {
    "dayjs": "^1.11.10",
    "react-image-crop": "^11.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5.0.0",
    "@ant-design/pro-components": ">=2.0.0",
    "@nutui/nutui-react-taro": ">=3.0.0",
    "@tarojs/components": ">=4.0.0",
    "@tarojs/taro": "^4.1.9",
    "antd": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@nutui/nutui-react-taro": {
      "optional": true
    },
    "@tarojs/components": {
      "optional": true
    },
    "@tarojs/taro": {
      "optional": true
    }
  }
}
